{
  "InfiniteSky": {
    "Application": {
      "Name": "InfiniteSky",
      "ShutdownTimeoutSeconds": 30
    },
    "Hosting": {
      "StartServicesConcurrently": false,
      "StopServicesConcurrently": false
    },
    "Diagnostics": {
      "ServiceName": "InfiniteSky"
    },
    "Authentication": {
      "TimeoutSeconds": 15
    },
    "Networking": {
      "Enabled": false,
      "BindAddress": "127.0.0.1",
      "LoginPort": 11091,
      "WorldPort": 11092,
      "MaxConcurrentConnections": 100,
      "MaxReceiveBufferBytes": 10240,
      "MaxFrameBytes": 10240,
      "SendQueueCapacity": 64,
      "IdleTimeoutSeconds": 120,
      "ConnectionShutdownTimeoutSeconds": 30
    },
    "Database": {
      "Enabled": false,
      "Provider": "MongoDB",
      "ConnectionString": "",
      "DatabaseName": "ts1",
      "AccountCollectionName": "account_mongooses",
      "CharacterCollectionName": "character_mongooses",
      "GuildCollectionName": "guilds",
      "EnsureIndexesOnStartup": true,
      "ResetActiveAccountsOnStartup": true,
      "ServerSelectionTimeoutSeconds": 5,
      "ConnectTimeoutSeconds": 5,
      "OperationTimeoutSeconds": 10,
      "HealthCheckIntervalSeconds": 30,
      "HealthCheckTimeoutSeconds": 3,
      "MinConnectionPoolSize": 0,
      "MaxConnectionPoolSize": 100
    },
    "Characters": {
      "ServerName": "Development"
    },
    "World": {
      "TickMilliseconds": 100
    },
    "Zones": {
      "Load": [],
      "AsyncLoadLimit": 4,
      "QuadTreeDepth": 6,
      "QuadTreeLimit": 10,
      "ViewableActionDistance": 500
    },
    "Gameplay": {
      "CompatibilityProfile": "LegacyParity"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
