{
  "InfiniteSky": {
    "Application": {
      "Name": "InfiniteSky",
      "ShutdownTimeoutSeconds": 30
    },
    "Networking": {
      "Enabled": false,
      "BindAddress": "127.0.0.1",
      "LoginPort": 11091,
      "WorldPort": 11092
    },
    "Database": {
      "Enabled": false,
      "Provider": "MongoDB",
      "ConnectionString": ""
    },
    "World": {
      "TickMilliseconds": 100
    },
    "Zones": {
      "Load": []
    },
    "Gameplay": {
      "CompatibilityProfile": "LegacyParity"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
