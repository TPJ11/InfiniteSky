{
  "InfiniteSky": {
    "Application": {
      "Name": "InfiniteSky",
      "ShutdownTimeoutSeconds": 30
    },
    "Hosting": {
      "StartServicesConcurrently": false,
      "StopServicesConcurrently": false
    },
    "Diagnostics": {
      "ServiceName": "InfiniteSky"
    },
    "Networking": {
      "Enabled": false,
      "BindAddress": "127.0.0.1",
      "LoginPort": 11091,
      "WorldPort": 11092,
      "MaxConcurrentConnections": 100,
      "MaxReceiveBufferBytes": 10240,
      "MaxFrameBytes": 10240,
      "SendQueueCapacity": 64,
      "IdleTimeoutSeconds": 120,
      "ConnectionShutdownTimeoutSeconds": 30
    },
    "Database": {
      "Enabled": false,
      "Provider": "MongoDB",
      "ConnectionString": ""
    },
    "World": {
      "TickMilliseconds": 100
    },
    "Zones": {
      "Load": []
    },
    "Gameplay": {
      "CompatibilityProfile": "LegacyParity"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
